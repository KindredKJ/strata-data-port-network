{
  "name": "@kindred-labs/strata-data-port-network",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs apps/portal/test/*.test.mjs community/test/*.test.mjs",
    "test:standalone": "node --test test/standalone-host.test.mjs",
    "serve:standalone": "node scripts/serve-standalone.mjs",
    "measure": "node scripts/measure-worker-transfer.mjs",
    "proof:receive": "node scripts/two-machine-receiver.mjs",
    "proof:send": "node scripts/two-machine-sender.mjs",
    "port:init": "node scripts/port-domain.mjs init",
    "port:renew": "node scripts/port-domain.mjs renew",
    "port:resolve": "node scripts/port-resolve.mjs",
    "portal:start": "node apps/portal/server.mjs",
    "portal:test": "node --test apps/portal/test/*.test.mjs",
    "community:test": "node --test community/test/*.test.mjs test/community-interop.test.mjs",
    "port:registry": "node scripts/numbered-port-registry.mjs",
    "port:assimilate": "node scripts/assimilate-native-host.mjs",
    "port:install": "node scripts/assimilate-native-host.mjs",
    "port:presence:test": "node --test test/port-presence-proof.test.mjs",
    "cdc:benchmark": "node scripts/benchmark-tesseract-cdc.mjs",
    "cdc:test": "node --test test/tesseract-cdc-delta.test.mjs test/tesseract-cdc-benchmark.test.mjs test/tesseract-cdc-native-session.test.mjs"
  },
  "exports": {
    "./worker-transfer": "./src/direct-pipe-worker-transfer.mjs",
    "./state-port": "./src/kindred-state-port.mjs",
    "./two-machine-proof": "./src/two-machine-proof.mjs",
    "./native-identity": "./src/native-port-identity.mjs",
    "./native-session": "./src/native-session.mjs",
    "./port-names": "./src/port-names.mjs",
    "./numbered-registry": "./src/numbered-port-registry.mjs",
    "./port-local-roles": "./src/port-local-roles.mjs",
    "./native-hardware-adapters": "./src/native-hardware-adapters.mjs",
    "./tesseract-reference-coordination": "./src/tesseract-reference-coordination.mjs",
    "./native-host-assimilation": "./src/native-host-assimilation.mjs",
    "./native-host-capability-bridge": "./src/native-host-capability-bridge.mjs",
    "./port-presence-proof": "./src/port-presence-proof.mjs",
    "./tesseract-cdc-delta": "./src/tesseract-cdc-delta.mjs",
    "./tesseract-cdc-native-session": "./src/tesseract-cdc-native-session.mjs"
  }
}
